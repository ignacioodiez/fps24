# Copia este archivo a ".env.dev" (que NO se sube a git) y rellena los valores.
# DATABASE_URL no hace falta: docker-compose.yml la fija a la base de datos local.

MODO=DESARROLLO

# Clave de TMDB (nueva, tras rotar la anterior). https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Secreto para POST /actualizar. En dev vale cualquier valor, distinto al de producción.
ACTUALIZAR_SECRET=dev-secret-cambiame
